{
	"name": "WikiArticleFeeds",
	"version": "3.0.0",
	"author": [
		"Jim Wilson",
		"Thomas Gries",
		"Jim Tittsler"
	],
	"url": "https://wikieducator.org/Extension:WikiArticleFeeds",
	"descriptionmsg": "wikiarticlefeeds-desc",
	"license-name": "MIT",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"platform": {
			"php": ">= 8.3"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\WikiArticleFeeds\\": "src/"
	},
	"Actions": {
		"feed": {
			"class": "MediaWiki\\Extension\\WikiArticleFeeds\\FeedAction",
			"services": [
				"MainWANObjectCache",
				"RedirectLookup",
				"RevisionLookup",
				"UrlUtils",
				"WikiPageFactory"
			]
		}
	},
	"MessagesDirs": {
		"WikiArticleFeeds": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"WikiArticleFeedsMagic": "WikiArticleFeeds.i18n.magic.php"
	},
	"TrackingCategories": [
		"wikiarticlefeeds-tracking-category"
	],
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\WikiArticleFeeds\\Hooks"
		}
	},
	"Hooks": {
		"ParserFirstCallInit": "main",
		"OutputPageParserOutput": "main",
		"SidebarBeforeOutput": "main",
		"HtmlPageLinkRendererEnd": "main"
	},
	"config": {
		"ForceArticleFeedSectionLinks": {
			"value": false,
			"description": "Link feed items to their section of the page, instead of to the first link in the item."
		},
		"WikiArticleFeedsSkipCache": {
			"value": false,
			"description": "Generate feeds on every request, without caching them. For debugging."
		}
	},
	"manifest_version": 2
}
