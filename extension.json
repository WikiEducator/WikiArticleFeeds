{
	"name": "WikiArticleFeeds",
	"version": "2.0.0",
	"author": [
		"Jim Wilson",
		"Thomas Gries",
		"Jim Tittsler"
	],
	"url": "https://wikieducator.org/Extension:WikiArticleFeeds",
	"descriptionmsg": "wikiarticlefeeds-desc",
	"license-name": "MIT",
	"type": "parserhook",
	"requires": {
