		"HtmlPageLinkRendererEnd": "WikiArticleFeeds::onHtmlPageLinkRendererEnd",
		"ArticlePurge": "WikiArticleFeeds::onArticlePurge",
		"ParserAfterTidy": "WikiArticleFeeds::onParserAfterTidy"
